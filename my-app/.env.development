# Server-only Hub CRM URL. The browser calls Hallway /api/crm; this proxy
# forwards to Hows (Project-ERP).
CRM_API_PROXY_TARGET=https://hows.hubinterior.com
# CRM Next.js frontend (CrmInceneration). Do not point this at the Hub API.
# Local CRM: http://localhost:3001  |  Prod: https://crm-inceneration.vercel.app
NEXT_PUBLIC_CRM_FRONTEND_URL=https://crm-inceneration.vercel.app
NEXT_PUBLIC_DESIGN_MODULE_FRONTEND_URL=https://design.hubinterior.com
# Same-origin Next.js routes (announcements, comments). Do NOT point at a remote host —
# that causes CORS "Failed to fetch" from localhost.
NEXT_PUBLIC_API_URL=/api
