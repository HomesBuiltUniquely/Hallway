# Hub CRM API only. Never open this host in the browser after login.
CRM_API_PROXY_TARGET=https://hows.hubinterior.com

# Optional Hub service account.
# CRM_USERNAME=admin
# CRM_PASSWORD=
# CRM_SHOWCASE_USER_ID=1

# Design Module login API (server-only)
DESIGN_MODULE_BASE_URL=https://api.hubinterior.com

# Dashboards opened from Hallway after login
# CRM Next.js frontend (CrmInceneration). Hallway opens:
#   {NEXT_PUBLIC_CRM_FRONTEND_URL}/auth/accept#payload=...
# Never point this at the Hub API host (hows.hubinterior.com).
NEXT_PUBLIC_CRM_FRONTEND_URL=https://crm-inceneration.vercel.app
NEXT_PUBLIC_DESIGN_MODULE_FRONTEND_URL=https://design.hubinterior.com
DESIGN_MODULE_FRONTEND_URL=https://design.hubinterior.com

# Announcements + comments (AppContext uses ${NEXT_PUBLIC_API_URL}/announcements)
NEXT_PUBLIC_API_URL=https://homesbuiltuniquelyhallways.vercel.app/api
