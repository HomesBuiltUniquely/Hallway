# Hub CRM API only. Never open this host in the browser after login.
CRM_API_PROXY_TARGET=https://hows.hubinterior.com

# Optional Hub service account.
# CRM_USERNAME=admin
# CRM_PASSWORD=
# CRM_SHOWCASE_USER_ID=1

# Design Module login API (server-only) — must be api.hubinterior.com, NOT design.hubinterior.com (SPA).
DESIGN_MODULE_BASE_URL=https://api.hubinterior.com

# Design Home Feed (Today + My Actions via Design /api/hallway/*). Default off unless set to true.
# FEATURE_DESIGN_HOME_FEED=true

# Booking celebration pop-ups (server-side eligibility)
# CELEBRATION_RECENCY_HOURS=24
# CELEBRATION_MAX_POPUPS=3
# Set at deploy so existing users never see pre-ship bookings (ISO UTC)
# HALLWAY_CELEBRATION_ROLLOUT_AT=2026-11-22T09:00:00.000Z
# Optional sound (off by default): NEXT_PUBLIC_CELEBRATION_SOUND_ENABLED=true

# Dashboards opened from Hallway after login
# CRM Next.js frontend (CrmInceneration). Hallway opens:
#   {NEXT_PUBLIC_CRM_FRONTEND_URL}/auth/accept#payload=...
# Never point this at the Hub API host (hows.hubinterior.com).
NEXT_PUBLIC_CRM_FRONTEND_URL=https://crm-inceneration.vercel.app
NEXT_PUBLIC_DESIGN_MODULE_FRONTEND_URL=https://design.hubinterior.com
DESIGN_MODULE_FRONTEND_URL=https://design.hubinterior.com

# Announcements + comments — same-origin Next.js /api routes only
NEXT_PUBLIC_API_URL=/api
